{
  "name": "bazi-culture-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'No static build step required'",
    "dev": "node scripts/local-polling.mjs",
    "dev:web": "node scripts/web-dev.mjs",
    "test": "node --test test/*.test.mjs",
    "cf:dev": "wrangler dev",
    "cf:db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production",
    "cf:deploy": "wrangler deploy --env production",
    "set:webhook": "node scripts/set-webhook.mjs"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "iztro": "2.5.8",
    "lunar-javascript": "1.7.7",
    "qimen-engine": "github:qfdk/qimen#8a9734a3fcaa01adc8bffc7c4b983c00ad932868"
  },
  "devDependencies": {
    "wrangler": "^4.32.0"
  },
  "engines": {
    "node": ">=20"
  }
}
