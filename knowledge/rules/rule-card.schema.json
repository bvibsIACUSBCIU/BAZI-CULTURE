{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bazi-culture-mvp.invalid/schemas/rule-card.schema.json",
  "title": "Bazi Culture MVP reviewed rule card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "status",
    "school_or_method",
    "concept",
    "plain_language_claim",
    "required_calculated_inputs",
    "prerequisites",
    "exclusions",
    "sources",
    "project_explanation",
    "competing_rules",
    "known_counterexamples",
    "allowed_user_facing_inference",
    "forbidden_inference",
    "confidence",
    "review"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^BZ-[A-Z0-9]+-[0-9]{4}$"
    },
    "status": {
      "enum": ["draft", "collated", "reviewed", "approved", "retired"]
    },
    "school_or_method": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "plain_language_claim": {
      "type": "string",
      "minLength": 1
    },
    "required_calculated_inputs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "exclusions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_location", "source_excerpt"],
        "properties": {
          "source_id": { "type": "string" },
          "source_location": { "type": "string", "minLength": 1 },
          "source_excerpt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "project_explanation": {
      "type": "string",
      "minLength": 1
    },
    "competing_rules": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "known_counterexamples": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_user_facing_inference": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "forbidden_inference": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "review_date", "change_history"],
      "properties": {
        "reviewer": { "type": ["string", "null"] },
        "review_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "change_history": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
